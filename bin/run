#!/usr/bin/env bash
# usage: bin/run --instance <instance.yaml> --data <private data dir> [collector ...]
# Runs the selected collectors (default: all), then the core ledger. Read-only toward every target.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
INSTANCE= DATA=
while [[ $# -gt 0 ]]; do case $1 in
  --instance) INSTANCE=$2; shift 2;; --data) DATA=$2; shift 2;; *) break;; esac; done
[[ -n $INSTANCE && -n $DATA ]] || { echo "usage: $0 --instance F --data DIR [collector...]" >&2; exit 2; }
COLLECTORS=("$@"); [[ ${#COLLECTORS[@]} -gt 0 ]] || COLLECTORS=(exposure host k8s vuln-intel codehost-github secrets-files agent-claude-code identity)
export SP_INSTANCE=$INSTANCE SP_DATA=$DATA SP_INSTANCE_NAME=$(awk '/^name:/{print $2; exit}' "$INSTANCE")
export SP_RUN_DIR=${SP_RUN_DIR:-$DATA/runs/$(date -u +%Y-%m-%d)}
mkdir -p "$SP_RUN_DIR"
for c in "${COLLECTORS[@]}"; do
  echo "== $c" >&2
  uv run -q --with pyyaml python3 "$ROOT/collectors/$c/collector.py" 2> >(tee "$SP_RUN_DIR/$c.log" >&2) || echo "collector $c failed (rc=$?)" >&2
done
uv run -q --with pyyaml python3 "$ROOT/core/ledger.py" --run "$SP_RUN_DIR" --data "$DATA"
