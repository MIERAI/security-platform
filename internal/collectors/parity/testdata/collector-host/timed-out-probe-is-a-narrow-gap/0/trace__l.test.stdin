SP_PROBE_TIMEOUT=20
SP_PROBE_SLOW_TIMEOUT=90
# Probe helpers, prepended by the collector to every POSIX profile. READ-ONLY. POSIX sh only: no `timeout` binary
# (macOS has none, busybox builds differ), no bash-isms; works in dash, bash (also as macOS /bin/sh), busybox ash.
#
#   sp_probe KEY SECONDS 'command'   prints KEY=<first line of the command's stdout>
#   sp_lines KEY SECONDS 'command'   prints the command's stdout lines unchanged (e.g. listen=... lines)
#
# A command still running after SECONDS is stopped (it and its descendants) and reported as `KEY=unknown` plus
# `probe.timeout=KEY` instead of a value; the rest of the output is unaffected. The collector turns that into a
# coverage gap for the checks that read KEY only ("could not check", never a pass).
# SP_PROBE_TIMEOUT / SP_PROBE_SLOW_TIMEOUT are set by the collector from the instance config.
# shellcheck shell=sh
: "${SP_PROBE_TIMEOUT:=20}" "${SP_PROBE_SLOW_TIMEOUT:=90}"
_sp_dir=$(mktemp -d "${TMPDIR:-/tmp}/sp-probe.XXXXXX" 2>/dev/null) || { _sp_dir="${TMPDIR:-/tmp}/sp-probe.$$"; mkdir -p "$_sp_dir"; }
trap 'rm -rf "$_sp_dir"' EXIT

_sp_tree() {  # $1 and every descendant (process table walk: ps -A on macOS/procps/toybox, plain ps on busybox)
  { ps -A -o pid= -o ppid= 2>/dev/null || ps -o pid,ppid 2>/dev/null; } | awk -v root="$1" '
    $1 ~ /^[0-9]+$/ { par[$1] = $2 }
    END { for (p in par) { q = p; n = 0; while (q != root && (q in par) && n++ < 64) q = par[q]; if (q == root) print p } }'
}

# shellcheck disable=SC2086  # $_sp_t is a list of process ids: split on purpose
_sp_stop() {  # TERM the tree, then KILL whatever is left
  _sp_t=$(_sp_tree "$1"); [ -n "$_sp_t" ] || _sp_t=$1
  kill -TERM $_sp_t 2>/dev/null; sleep 1; kill -KILL $_sp_t 2>/dev/null
}

_sp_run() {  # _sp_run SECONDS 'command': stdout in $_sp_dir/out; returns 124 when the time limit stopped it
  case $1 in ''|*[!0-9]*) set -- 20 "$2";; esac   # not a whole number of seconds: the default, never "no limit"
  rm -f "$_sp_dir/out" "$_sp_dir/fired"
  ( eval "$2" ) >"$_sp_dir/out" 2>/dev/null </dev/null &
  _sp_pid=$!
  (
    sleep "$1" & _sp_s=$!
    trap 'kill $_sp_s 2>/dev/null; exit 0' TERM
    wait $_sp_s || exit 0
    : >"$_sp_dir/fired"; _sp_stop "$_sp_pid"
  ) >/dev/null 2>&1 </dev/null &
  _sp_wd=$!
  wait "$_sp_pid" 2>/dev/null
  kill -TERM "$_sp_wd" 2>/dev/null; wait "$_sp_wd" 2>/dev/null
  [ -f "$_sp_dir/fired" ] && return 124
  return 0
}

sp_probe() {
  if _sp_run "$2" "$3"; then printf '%s=%s\n' "$1" "$(head -n 1 "$_sp_dir/out")"
  else printf '%s=unknown\nprobe.timeout=%s\n' "$1" "$1"; fi
}

sp_lines() {
  if _sp_run "$2" "$3"; then cat "$_sp_dir/out"
  else printf 'probe.timeout=%s\n' "$1"; fi
}

# host profile: linux (systemd distros). READ-ONLY. Output: key=value lines. Uses `sudo -n` (never prompts).
# sp_probe/sp_lines: probe.sh (per-command limits). Package-manager probes run LAST with the slow limit.
# shellcheck shell=sh
# shellcheck disable=SC2016  # probe commands are single-quoted on purpose: sp_probe/sp_lines evaluate them
# shellcheck disable=SC2034  # S is used inside the evaluated probe commands
S="sudo -n"; T=$SP_PROBE_TIMEOUT
sp_lines sshd "$T" '$S sshd -T 2>/dev/null | awk "{k=tolower(\$1)} k~/^(passwordauthentication|permitrootlogin|kbdinteractiveauthentication|pubkeyauthentication|permitemptypasswords|x11forwarding|maxauthtries)\$/{print \"sshd.\"k\"=\"tolower(\$2)}"'
# shellcheck disable=SC1091  # the host's own file, read at run time
. /etc/os-release 2>/dev/null; echo "os.name=$PRETTY_NAME"; echo "os.kernel=$(uname -r)"
test -f /var/run/reboot-required && echo reboot_required=yes || echo reboot_required=no
echo "uptime_days=$(awk '{print int($1/86400)}' /proc/uptime)"
sp_probe fw.ufw "$T" '$S ufw status 2>/dev/null | head -1 | awk "{print \$NF}"'
sp_probe fw.nft_input_policy "$T" '$S nft list chain inet filter input 2>/dev/null | grep -o "policy [a-z]*" | head -1 | cut -d" " -f2'
sp_probe fw.iptables_input_policy "$T" '$S iptables -S INPUT 2>/dev/null | awk "/^-P INPUT/{print \$3}"'
sp_probe disk.crypt_devices "$T" 'lsblk -rno TYPE 2>/dev/null | grep -c crypt'
sp_probe audit.auditd "$T" 'systemctl is-active auditd 2>/dev/null'
sp_probe audit.fail2ban "$T" 'systemctl is-active fail2ban 2>/dev/null'
sp_lines listen "$T" '$S ss -Htlnp 2>/dev/null | awk "{split(\$6,a,\"\\\"\"); print \"listen=\"\$4\" \"a[2]}" | sort -u'
if command -v apt >/dev/null; then
  sp_probe pkg.auto_updates "$T" 'grep -hs "Unattended-Upgrade \"1\"" /etc/apt/apt.conf.d/20auto-upgrades >/dev/null && echo yes || echo no'
  sp_probe pkg.cache_mtime "$T" 'stat -c %Y /var/cache/apt/pkgcache.bin 2>/dev/null'
  sp_probe pkg.count "$T" 'dpkg-query -W 2>/dev/null | wc -l'
  sp_probe pkg.upgradable "$SP_PROBE_SLOW_TIMEOUT" 'apt list --upgradable 2>/dev/null | grep -c upgradable'
  sp_probe pkg.security_upgradable "$SP_PROBE_SLOW_TIMEOUT" 'apt list --upgradable 2>/dev/null | grep -c -- -security'
fi

echo probe.end=1
