# HELP security_collector_findings Findings reported by the latest run of a collector
# TYPE security_collector_findings gauge
security_collector_findings{collector="secrets-files",layer="data-secrets",severity="high"} 3
security_collector_findings{collector="secrets-files",layer="data-secrets",severity="low"} 3
security_collector_findings{collector="secrets-files",layer="data-secrets",severity="medium"} 4
# HELP security_collector_gaps Assets the collector could not cover
# TYPE security_collector_gaps gauge
security_collector_gaps{collector="secrets-files"} 3
# HELP security_collector_assets Assets in scope of the run
# TYPE security_collector_assets gauge
security_collector_assets{collector="secrets-files"} 5
# HELP security_collector_last_run_timestamp_seconds Heartbeat: when the collector last finished (no findings != secure)
# TYPE security_collector_last_run_timestamp_seconds gauge
security_collector_last_run_timestamp_seconds{collector="secrets-files"} T
# HELP security_secrets_total Secret files found
# TYPE security_secrets_total counter
security_secrets_total{collector="secrets-files",store="files:srv"} 9
# HELP security_secrets_older_than_90d Secret files older than 90 days
# TYPE security_secrets_older_than_90d gauge
security_secrets_older_than_90d{collector="secrets-files",store="files:srv"} 3
security_secrets_total{collector="secrets-files",store="files:win"} 2
security_secrets_older_than_90d{collector="secrets-files",store="files:win"} 0
