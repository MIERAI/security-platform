# HELP security_score Security scorecard: weighted pass ratio of the controls (0-100); the weakest dimension decides
# TYPE security_score gauge
security_score{dimension="alpha"} 100
security_score{dimension="beta"} 100
security_score{pillar="network"} 0
security_score{pillar="device"} 100
security_score{pillar="people"} 0
security_score{pillar="software"} 0
security_score{function="PR"} 100
security_score{dimension="alpha",pillar="device"} 100
security_score{dimension="beta",pillar="device"} 100
# HELP security_score_overall Overall score = the weakest dimension's score
# TYPE security_score_overall gauge
security_score_overall 100
# HELP security_score_threshold A dimension below this fails the scorecard
# TYPE security_score_threshold gauge
security_score_threshold 75
# HELP security_score_pass 1 while every dimension meets its threshold
# TYPE security_score_pass gauge
security_score_pass 1
# HELP security_score_controls Controls per dimension and result (details in the private scorecard report)
# TYPE security_score_controls gauge
security_score_controls{dimension="alpha",status="pass"} 1
security_score_controls{dimension="alpha",status="fail"} 0
security_score_controls{dimension="alpha",status="na"} 0
security_score_controls{dimension="beta",status="pass"} 1
security_score_controls{dimension="beta",status="fail"} 0
security_score_controls{dimension="beta",status="na"} 0
# HELP security_score_regressions_total Times the dimension dropped below its threshold (counter; the alert fires on increases)
# TYPE security_score_regressions_total counter
security_score_regressions_total{dimension="alpha"} 1
security_score_regressions_total{dimension="beta"} 0
# HELP security_attestations Attested (human) controls by state; expired ones fail again
# TYPE security_attestations gauge
security_attestations{state="valid"} 0
security_attestations{state="expiring"} 0
security_attestations{state="expired"} 0
security_attestations{state="missing"} 0
# HELP security_scorecard_last_compute_timestamp_seconds When the scorecard was last computed
# TYPE security_scorecard_last_compute_timestamp_seconds gauge
security_scorecard_last_compute_timestamp_seconds 1894233600
