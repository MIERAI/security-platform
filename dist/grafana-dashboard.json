{
 "uid": "security-platform",
 "title": "Security platform",
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "security-platform",
  "generator-0.2.0"
 ],
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   },
   {
    "name": "namespace",
    "type": "query",
    "label": "namespace",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(security_ledger_last_update_timestamp_seconds, namespace)",
     "refId": "ns"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": false,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 2,
   "type": "row",
   "title": "Security SLIs (value; red = above objective)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "unauth_network_services",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(security_sli{namespace=~\"$namespace\", sli=\"unauth_network_services\"})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Sensitive services that answer without authentication from the external vantage point (objective <= 0)"
  },
