{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "security-platform/scorecard-catalog/v1",
 "title": "A scorecard catalog file: one dimension and its controls (YAML or JSON)",
 "type": "object",
 "required": [
  "schema",
  "dimension"
 ],
 "properties": {
  "schema": {
   "const": "security-platform/scorecard-catalog/v1"
  },
  "dimension": {
   "type": "object",
   "required": [
    "id",
    "title",
    "order"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "title": {
     "type": "string"
    },
    "order": {
     "type": "integer"
    },
    "description": {
     "type": "string"
    },
    "owner": {
     "type": "string"
    },
    "threshold": {
     "type": "number"
    },
    "pillars": {
     "type": "array",
     "items": {
      "enum": [
       "network",
       "device",
       "people",
       "software"
      ]
     }
    },
    "applies_when": {
     "$ref": "#/$defs/applies"
    }
   }
  },
  "controls": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "csf",
     "check",
     "weight"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9_.-]+$",
      "description": "<dimension>.<name>"
     },
     "title": {
      "type": "string"
     },
     "csf": {
      "type": "string",
      "pattern": "^(GV|ID|PR|DE|RS|RC)(\\.|$)"
     },
     "cis": {
      "type": "array"
     },
     "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
       "enum": [
        "network",
        "device",
        "people",
        "software"
       ]
      }
     },
     "check": {
      "enum": [
       "automated",
       "attested",
       "evidence"
      ]
     },
     "weight": {
      "type": "number",
      "minimum": 0
     },
     "validity": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?[smhdw]$"
     },
     "question": {
      "type": "string"
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "needs_human": {
      "type": "boolean"
     },
     "remediation": {
      "type": "string"
     },
     "applies_when": {
      "$ref": "#/$defs/applies"
     },
     "source": {
      "type": "object",
      "required": [
       "type"
      ],
      "properties": {
       "type": {
        "enum": [
         "findings",
         "sli",
         "metric",
         "collector_fresh",
         "job",
         "file",
         "all",
         "any",
         "first_known",
         "attestation",
         "builtin",
         "none"
        ]
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "applies": {
   "type": "object",
   "description": "exactly one of {instance: <dotted key>}, {coverage_prefix: <asset prefix>}, {any: [..]}",
   "properties": {
    "instance": {
     "type": "string"
    },
    "coverage_prefix": {
     "type": "string"
    },
    "any": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/applies"
     }
    }
   }
  }
 }
}