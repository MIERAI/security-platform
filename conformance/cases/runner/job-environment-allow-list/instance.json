{
 "name": "conformance",
 "runner": {
  "env_passthrough": [
   "MY_PASSED"
  ],
  "jobs": {
   "renamed": {
    "argv": [
     "/bin/sh",
     "{case}/emit.sh"
    ],
    "collector": "host",
    "env": {
     "EMIT_DOC": "{case}/host.json",
     "EMIT_ENV_ALL": "{sandbox}/env-all.txt",
     "EMIT_MARK": "{sandbox}/runs.log",
     "MY_SETTING": "x"
    },
    "schedule": "0 * * * *",
    "type": "command"
   }
  },
  "outbox": {
   "dir": "{sandbox}/outbox",
   "type": "local"
  },
  "role": "site",
  "site": "s1"
 }
}
