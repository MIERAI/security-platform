{
 "component": "runner",
 "title": "max_delay: a slot older than this is skipped (not run late); the next slot runs",
 "contract": "runner/1.0",
 "origin": "tests/test_runner.py::test_catch_up_jitter_retry_max_delay",
 "files": {
  "instance.json": "instance.json"
 },
 "steps": [
  {
   "name": "tick at 2030-01-07T12:00:00Z",
   "exec": {
    "impl": "runner",
    "args": [
     "tick",
     "--instance",
     "{sandbox}/instance.json",
     "--data",
     "{sandbox}/data",
     "--now",
     "1894017600"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "absent": "runs.log"
    }
   ]
  },
  {
   "name": "status at 2030-01-07T12:00:00Z",
   "exec": {
    "impl": "runner",
    "args": [
     "status",
     "--instance",
     "{sandbox}/instance.json",
     "--data",
     "{sandbox}/data",
     "--now",
     "1894017600"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "stdout": {
      "schema": "runner-status",
      "json": {
       "nightly": {
        "due": "missed (older than max_delay)",
        "schedule": "30 3 * * *"
       }
      }
     }
    }
   ]
  },
  {
   "name": "tick at 2030-01-08T04:00:00Z",
   "exec": {
    "impl": "runner",
    "args": [
     "tick",
     "--instance",
     "{sandbox}/instance.json",
     "--data",
     "{sandbox}/data",
     "--now",
     "1894075200"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "data/state/runner/nightly.json",
     "schema": "runner-state",
     "subset": {
      "runs_total": 1,
      "done_slot": 1894073400
     }
    }
   ]
  }
 ]
}
