{
 "name": "conformance",
 "runner": {
  "jobs": {
   "bad": {
    "argv": [
     "/bin/sh",
     "{case}/emit.sh"
    ],
    "collector": "host",
    "env": {
     "EMIT_DOC": "{case}/bad.json",
     "EMIT_MARK": "{sandbox}/runs.log"
    },
    "schedule": "0 * * * *",
    "type": "command"
   }
  },
  "outbox": {
   "dir": "{sandbox}/outbox",
   "type": "local"
  },
  "role": "site",
  "site": "s1"
 }
}
