        "status": "ok"
       },
       {
        "asset": "host:win",
        "status": "ok"
       },
       {
        "asset": "host:broken",
        "status": "gap",
        "reason": "inventory failed rc=0: dpkg-query: permission denied"
       },
       {
        "asset": "host:dormant",
        "status": "gap",
        "reason": "no exec adapter configured"
       }
      ],
      "findings": [
       {
        "check": "sbom.no_packages",
        "asset": "host:phone",
        "severity": "info",
