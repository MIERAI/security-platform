 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-host-sbom",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:/usr/bin:/bin",
     "FAKE_EXEC": "{sandbox}"
    },
    "writes_only_under": [
     "run",
     "trace"
    ]
   },
   "expect": [
    {
     "json": "run/host-sbom.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "host-sbom"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/host-sbom.findings.json",
     "subset": {
      "coverage": [
       {
        "asset": "host:deb",
        "status": "ok"
       },
       {
        "asset": "host:deb/fs-sbom",
        "status": "gap",
        "reason": {
         "$regex": "local exec adapter"
        }
       },
       {
        "asset": "host:mac",
        "status": "ok"
       },
       {
        "asset": "host:rtr",
        "status": "ok"
       },
