{
 "component": "cli",
 "title": "`--ids` prints one id per line (for scripts); the table shows the due date or OVERDUE",
 "contract": "cli/1.1",
 "origin": "cli/sp.py cmd_findings",
 "files": {
  "data/ledger.json": "ledger.json",
  "data/tracker/items.json": "items.json",
  "data/instance.json": "instance.json"
 },
 "steps": [
  {
   "name": "sp findings --open --ids --data {sandbox}/data",
   "exec": {
    "impl": "cli",
    "args": [
     "findings",
     "--open",
     "--ids",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "stdout": {
      "lines": [
       "7eafa19e3d35",
       "d610b9b1761d",
       "e68dbe52f93c"
      ]
     }
    }
   ]
  },
  {
   "name": "sp findings --open --data {sandbox}/data",
   "exec": {
    "impl": "cli",
    "args": [
     "findings",
     "--open",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "stdout": {
      "regex": [
       "^7eafa19e3d35\\s+critical\\s+open\\s+OVERDUE",
       "^d610b9b1761d\\s+high\\s+open\\s+2099-12-01",
       "^e68dbe52f93c\\s+low\\s+open\\s+-\\s"
      ]
     }
    }
   ]
  },
  {
   "name": "sp findings --check nothing.matches --data {sandbox}/data",
   "exec": {
    "impl": "cli",
    "args": [
     "findings",
     "--check",
     "nothing.matches",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "stdout": {
      "regex": [
       "no matching findings"
      ]
     }
    }
   ]
  }
 ]
}
