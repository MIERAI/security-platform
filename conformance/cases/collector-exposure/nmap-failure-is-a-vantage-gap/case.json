{
 "component": "collector-exposure",
 "title": "nmap failing on the vantage is a `vantage` coverage gap inside a valid document (exit 0), not a clean result and not a crash",
 "contract": "collector-protocol/1.0 §5",
 "origin": "collectors/exposure",
 "files": {
  "instance.json": {
   "json": {
    "name": "conformance",
    "exposure": {
     "discovery": [
      {
       "type": "static",
       "targets": [
        {
         "name": "web",
         "address": "127.0.0.1"
        }
       ]
      }
     ],
     "vantage": {
      "type": "local"
     }
    }
   }
  },
  "nmap.json": {
   "json": {
    "rc": 1,
    "stderr": "nmap: Failed to open device"
   }
  },
  "bin/nmap": {
   "text": "#!/bin/sh\nexec \"{python}\" \"{case}/fake_nmap.py\" \"$@\"\n",
   "mode": "0755"
  },
  "bin/python": {
   "text": "#!/bin/sh\nexec \"{python}\" \"$@\"\n",
   "mode": "0755"
  },
  "data/.keep": {
   "text": ""
  }
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-exposure",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "FAKE_NMAP_SPEC": "{sandbox}/nmap.json"
    },
    "writes_only_under": [
     "run",
     "nmaplog"
    ],
    "path_prepend": [
     "{sandbox}/bin"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "run/exposure.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "exposure"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "coverage": {
       "$contains": [
        {
         "asset": "vantage",
         "status": "gap",
         "reason": {
          "$regex": "^probe failed rc=1: "
         }
        },
        {
         "asset": "host:web",
         "status": "ok"
        }
       ]
      }
     }
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "findings": [],
      "metrics": []
     }
    }
   ]
  }
 ]
}
