{
 "component": "collector-exposure",
 "title": "Re-classification of a recorded probe result (SP_EXPOSURE_RAW) after discovery from an overlay network (fake tailscale), static targets and an asset file: every fingerprint class, verified hosts with nothing open are covered, offline and out-of-scope assets, discovery failures are gaps",
 "contract": "collector-protocol/1.0",
 "origin": "collectors/exposure classify(); adapters/discovery.py",
 "files": {
