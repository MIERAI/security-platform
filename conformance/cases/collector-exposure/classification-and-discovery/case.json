 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-exposure",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "SP_EXPOSURE_RAW": "{sandbox}/probe.json"
    },
    "writes_only_under": [
     "run"
    ],
    "path_prepend": [
     "{sandbox}/bin"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "run/exposure.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "exposure"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "findings": {
       "$contains": [
        {
         "check": "overlay.node_key_expiry_disabled",
         "asset": "host:nas",
         "layer": "identity",
         "needs_human": true
        },
        {
         "check": "http.catch_all_unverified",
         "asset": "net-endpoint:nas@100.64.0.1:3000"
        },
        {
         "check": "alertmanager.unauth",
         "asset": "net-endpoint:nas@100.64.0.1:9093"
        },
        {
         "check": "ollama.unauth",
         "asset": "net-endpoint:nas@100.64.0.1:11434"
        },
        {
         "check": "prometheus.unauth_read",
         "asset": "net-endpoint:nas@100.64.0.1:9090"
        },
        {
         "check": "prometheus.unauth_remote_write",
         "asset": "net-endpoint:nas@100.64.0.1:9090"
        },
        {
         "check": "prometheus.admin_api_unauth",
         "asset": "net-endpoint:nas@100.64.0.1:9090"
        },
        {
         "check": "blackbox.open_probe",
         "asset": "net-endpoint:edge@198.51.100.7:9115"
        },
        {
         "check": "otlp.unauth_ingest",
         "asset": "net-endpoint:edge@198.51.100.7:4318"
        },
        {
         "check": "metrics.unauth",
         "asset": "net-endpoint:edge@198.51.100.7:8080"
        },
        {
         "check": "http.unauth_root",
         "asset": "net-endpoint:edge@198.51.100.7:8081"
        },
        {
         "check": "telnet.open",
         "asset": "net-endpoint:edge@198.51.100.7:23"
        },
        {
         "check": "smb.reachable",
         "asset": "net-endpoint:edge@198.51.100.7:445",
         "title": "SMB (microsoft-ds) is reachable from the vantage point (198.51.100.7:445)"
        },
        {
         "check": "db.reachable",
         "asset": "net-endpoint:edge@198.51.100.7:6379",
         "title": "database port reachable from the vantage point (6379) (198.51.100.7:6379)"
        },
        {
         "check": "tempo.unauth_read",
         "asset": "net-endpoint:203.0.113.9@203.0.113.9:3200"
        }
       ]
      }
     }
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "findings": {
       "$not_contains": [
        {
         "asset": "net-endpoint:edge@198.51.100.7:8443"
        },
        {
         "asset": "host:printer"
        },
        {
         "check": "overlay.node_key_expiry_disabled",
         "asset": "host:scanner"
        }
       ]
      }
     }
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "coverage": {
       "$contains": [
        {
         "asset": "discovery:static",
         "status": "gap",
         "reason": "ValueError: CIDR 10.0.0.0/16 has 65536 addresses (max_hosts 1024)"
        },
        {
         "asset": "discovery:aws-vpc",
         "status": "gap",
         "reason": "NotImplementedError: discovery adapter 'aws-vpc' is a documented future adapter"
        },
        {
         "asset": "host:old",
         "status": "gap",
         "reason": "offline at scan time"
        },
        {
         "asset": "net-endpoint:printer@100.64.0.2",
         "status": "ok"
        },
        {
         "asset": "host:filehost",
         "status": "gap",
         "reason": "no open port seen from the vantage point (down or filtered)"
        },
        {
         "asset": "host:scanner",
         "status": "ok"
        }
       ]
      }
     }
    },
    {
     "json": "run/exposure.findings.json",
     "subset": {
      "coverage": {
       "$not_contains": [
        {
         "asset": "host:laptop"
        },
        {
         "asset": "host:phone"
        }
       ]
      },
      "collector": {
       "tools": {
        "nmap": "Nmap version 7.95 ( https://nmap.org )"
       }
      }
     }
    },
    {
     "prom": "run/exposure.prom",
     "has": [
      {
       "name": "security_exposure_open_ports",
       "value": 13
      },
      {
       "name": "security_exposure_unauth_services",
       "value": 11
      }
     ]
    }
   ]
  }
 ]
}
