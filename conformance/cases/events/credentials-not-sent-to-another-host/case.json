{
 "component": "events",
 "title": "A redirect to another host does not take the API token along",
 "contract": "events/1.0 (secrets)",
 "origin": "events/ship.py HTTP: urllib copies the Authorization header to the redirect target",
 "deviation": "EVENTS-D1",
 "services": [
  {
   "name": "obs",
   "argv": [
    "{python}",
    "{case}/mock_events.py"
   ]
  }
 ],
 "files": {
  "out/.keep": {
   "text": ""
  },
  "events.json": {
   "json": {
    "loki": {
     "url": "{svc_obs}/loki/api/v1/push"
    },
    "sources": [
     {
      "name": "gh",
      "type": "github-account",
      "host": "acme-bot",
      "api": "{svc_obs}",
      "token_env": "EV_GH_TOKEN"
     }
    ]
   }
  },
  "api.json": {
   "json": {
    "/user": [
     200,
     {
      "login": "acme-bot"
     }
    ],
    "/user/keys": [
     200,
     [
      {
       "id": 1,
       "title": "laptop",
       "created_at": "2026-01-01T00:00:00Z"
      }
     ]
    ],
    "/user/gpg_keys": {
     "redirect": "/elsewhere"
    },
    "/user/ssh_signing_keys": [
     200,
     []
    ],
    "/user/repos": [
     200,
     [
      {
       "full_name": "acme-bot/site",
       "visibility": "private",
       "owner": {
        "login": "acme-bot"
       },
       "pushed_at": "2026-11-01T00:00:00Z"
      }
     ]
    ],
    "/repos/acme-bot/site/keys": [
     200,
     []
    ],
    "/repos/acme-bot/site/hooks": [
     200,
     []
    ],
    "/user/installations": [
     200,
     {
      "installations": []
     }
    ],
    "/users/acme-bot/events": [
     200,
     []
    ],
    "/elsewhere": [
     200,
     []
    ]
   }
  }
 },
 "steps": [
  {
   "name": "ship",
   "exec": {
    "impl": "events",
    "args": [
     "--config",
     "{sandbox}/events.json",
     "--state",
     "{sandbox}/state",
     "--summary",
     "{sandbox}/out/summary.json",
     "--now",
     "1795608000"
    ],
    "writes_only_under": [
     "state",
     "out",
     "pushed",
     "leak"
    ],
    "env": {
     "EV_GH_TOKEN": "{canary_token}"
    }
   },
   "exit": {
    "in": [
     0,
     1
    ]
   },
   "expect": [
    {
     "absent": "leak/auth.txt"
    },
    {
     "absent": "mutations.log"
    },
    {
     "writes_only_under": true
    }
   ]
  }
 ]
}
