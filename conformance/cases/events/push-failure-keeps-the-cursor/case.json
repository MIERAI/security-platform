{
 "component": "events",
 "title": "A failed push keeps the cursor (exit 1, no state written); the next run delivers the same events (at least once)",
 "contract": "events/1.0",
 "origin": "events/ship.py main: the cursor is stored only after the push",
 "services": [
  {
   "name": "obs",
   "argv": [
    "{python}",
    "{case}/mock_events.py"
   ]
  }
 ],
 "files": {
  "out/.keep": {
   "text": ""
  },
  "events.json": {
   "json": {
    "loki": {
     "url": "{svc_obs}/loki/api/v1/push"
    },
    "sources": [
     {
      "name": "lab-auth",
      "type": "command",
      "host": "lab",
      "parser": "openssh",
      "argv": [
       "cat",
       "{sandbox}/auth.log"
      ]
     }
    ]
   }
  },
  "auth.log": {
   "text": "2026-11-25T11:40:00+00:00 lab sshd[101]: Accepted publickey for ops from 10.0.0.1 port 50000 ssh2\n2026-11-25T11:41:00+00:00 lab sshd[102]: Failed password for invalid user admin from 192.0.2.7 port 50001 ssh2\n2026-11-25T11:42:00+00:00 lab sudo:      ops : TTY=pts/0 ; PWD=/home/ops ; USER=root ; COMMAND=/usr/bin/id\n2026-11-25T11:43:00+00:00 lab cron[5]: unrelated\n"
  },
  "loki-fail": {
   "text": ""
  }
 },
 "steps": [
  {
   "name": "store down",
   "exec": {
    "impl": "events",
    "args": [
     "--config",
     "{sandbox}/events.json",
     "--state",
     "{sandbox}/state",
     "--summary",
     "{sandbox}/out/summary.json",
     "--now",
     "1795608000"
    ],
    "writes_only_under": [
     "state",
     "out",
     "pushed",
     "leak"
    ]
   },
   "exit": 1,
   "expect": [
    {
     "json": "out/summary.json",
     "subset": {
      "sources": {
       "lab-auth": {
        "ok": false,
        "error": {
         "$regex": "500"
        }
       }
      }
     }
    },
    {
     "absent": "state/lab-auth.json"
    },
    {
     "absent": "pushed/0001.json"
    },
    {
     "stderr": {
      "regex": [
       "lab-auth: FAILED .*cursor kept"
      ]
     }
    },
    {
     "absent": "mutations.log"
    },
    {
     "writes_only_under": true
    }
   ]
  },
  {
   "name": "store back",
   "exec": {
    "impl": "events",
    "args": [
     "--config",
     "{sandbox}/events.json",
     "--state",
     "{sandbox}/state",
     "--summary",
     "{sandbox}/out/summary.json",
     "--now",
     "1795608000"
    ],
    "writes_only_under": [
     "state",
     "out",
     "pushed",
     "leak"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "out/summary.json",
     "subset": {
      "sources": {
       "lab-auth": {
        "ok": true,
        "shipped": 3
       }
      }
     }
    },
    {
     "file": "pushed/0001.json",
     "regex": [
      "\"event\": \"sudo\""
     ]
    },
    {
     "exists": "state/lab-auth.json"
    },
    {
     "absent": "mutations.log"
    },
    {
     "writes_only_under": true
    }
   ],
   "remove": [
    "loki-fail"
   ]
  }
 ]
}
