{
 "component": "collector-identity",
 "title": "Code host (2FA unknown, org 2FA policy, unexpected collaborators, unused deploy keys, fork-PR approval, the token's age and scopes), overlay-network devices through the local CLI (expired, expiring, dormant), an interface-only provider, local credential stores (kubeconfig certificate expiry and groups, static and exec users, SSH keys, registry logins, token files and their modes): metadata only, read-only calls, no secret value in any output; the second run revalidates every cached answer with its ETag",
 "contract": "collector-protocol/1.0 / findings/1.2",
 "origin": "collectors/identity/collector.py; tests/test_identity.py",
 "services": [
  {
   "name": "api",
   "argv": [
    "{python}",
    "{case}/mock_api.py",
    "--data",
    "{case}/api.json",
    "--log",
    "{sandbox}/.svc-api.calls"
   ]
  }
 ],
 "files": {
  "instance.json": "instance.json",
  "data/.keep": {
   "text": ""
  },
  "bin/gh": {
   "text": "#!/bin/sh\nexec \"{python}\" \"{case}/fake_gh.py\" \"$@\"\n",
   "mode": "0755"
  },
  "bin/security": {
   "text": "#!/bin/sh\n# fake macOS keychain: attributes only (a fixed creation date), never a secret\ncat \"{case}/keychain.txt\"\n",
   "mode": "0755"
  },
  "bin/tailscale": {
   "text": "#!/bin/sh\n[ \"$1 $2\" = \"status --json\" ] || { echo \"fake tailscale: $*\" >&2; exit 1; }\ncat \"{sandbox}/tailscale-status.json\"\n",
   "mode": "0755"
  },
  "tailscale-status.json": "tailscale-status.json",
  "home/.kube/config.yaml": {
   "text": "apiVersion: v1\nkind: Config\nusers:\n- name: admin\n  user:\n    client-certificate-data: \n    client-key-data: {fake_key}\n- name: ci\n  user:\n    token: kube-conformance-token-canary-51aa\n- name: sso\n  user:\n    exec:\n      apiVersion: client.authentication.k8s.io/v1\n      command: /usr/local/bin/kubelogin\n      args: [get-token]\n",
   "mode": "0600"
  },
  "home/.kube/excluded.yaml": {
   "text": "users:\n- name: x\n  user: {token: kube-conformance-token-canary-51aa}\n",
   "mode": "0600"
  },
  "home/.ssh/id_ed25519": {
   "text": "{fake_key}\n",
   "mode": "0600"
  },
  "home/.ssh/id_ed25519.pub": {
   "text": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIconformance octo@laptop\n",
   "mode": "0644"
  },
  "home/.ssh/id_rsa_nopub": {
   "text": "{fake_key}\n",
   "mode": "0600"
  },
  "home/.ssh/work_key": {
   "text": "{fake_key}\n",
   "mode": "0600"
  },
  "home/.ssh/work_key.pub": {
   "text": "ssh-rsa AAAAB3conformance work\n",
   "mode": "0644"
  },
  "home/.docker/config.json": {
   "json": {
    "auths": {
     "registry.example": {
      "auth": "docker-conformance-auth-canary-2f0e"
     },
     "skip.example": {},
     "ghcr.example": {}
    },
    "credsStore": "desktop"
   },
   "mode": "0600"
  },
  "home/.config/sp/a.token": {
   "text": "token-file-canary-0b3d\n",
   "mode": "0644"
  },
  "home/.config/sp/b.token": {
   "text": "token-file-canary-0b3d\n",
   "mode": "0600"
  }
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-identity",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:{path}",
     "FAKE_GH_URL": "{svc_api}",
     "FAKE_GH_LOG": "{sandbox}/.svc-gh.calls"
    },
    "writes_only_under": [
     "run",
     "data/cache"
    ]
   },
   "expect": [
    {
     "json": "run/identity.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "identity"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "no_secret": [
      "conformanceCanary",
      "kube-conformance-token-canary-51aa",
      "docker-conformance-auth-canary-2f0e",
      "{fake_key}",
      "token-file-canary-0b3d",
      "ts-conformance-api-key-canary-4b2e",
      "ts-conformance-oauth-secret-canary-9a3c",
      "ts-conformance-access-canary-1c4f"
     ],
     "in": "run"
    },
    {
     "json": "run/identity.findings.json",
     "subset": {
      "collector": {
       "tools": {
        "identity-adapter": "0.2.0"
       }
      },
      "coverage": [
       {
        "asset": "identity-mfa:github/octo",
        "status": "gap",
        "reason": {
         "$regex": "user` scope"
        }
       },
       {
        "asset": "identity:github/octo",
        "status": "ok"
       },
       {
        "asset": "org:github/acme",
        "status": "ok"
       },
       {
        "asset": "repo:github/octo/app/collaborators",
        "status": "ok"
       },
       {
        "asset": "repo:github/octo/notes/collaborators",
        "status": "ok"
       },
       {
        "asset": "identity-provider:tailscale",
        "status": "gap",
        "reason": {
         "$regex": "no read-only API key"
        }
       },
       {
        "asset": "identity-devices:tailscale",
        "status": "ok"
       },
       {
        "asset": "identity-provider:google-workspace",
        "status": "gap",
        "reason": "identity provider 'google-workspace' is a documented interface, not implemented"
       },
       {
        "asset": {
         "$regex": "^credential-store:.*/home/.kube/config.yaml$"
        },
        "status": "ok"
       },
       {
        "asset": {
         "$regex": "^credential-store:.*/home/.ssh$"
        },
        "status": "ok"
       },
       {
        "asset": {
         "$regex": "^credential-store:.*/home/.docker/config.json$"
        },
        "status": "ok"
       }
      ],
      "findings": {
       "$unordered": [
        {
         "check": "identity.org_mfa_not_required",
         "asset": "org:github/acme",
         "severity": "medium",
         "needs_human": true,
         "owner": "human",
         "evidence": "raw/identity/inventory.json",
         "title": "organisation acme does not require 2FA of its members"
        },
        {
         "check": "identity.collaborator_unexpected",
         "asset": "repo:github/octo/app/collaborator/mallory",
         "severity": "high",
         "title": "mallory has push access to github/octo/app and is not in the expected list"
        },
        {
         "check": "identity.collaborator_unexpected",
         "asset": "repo:github/octo/notes/collaborator/viewer",
         "severity": "medium"
        },
        {
         "check": "identity.deploy_key_unused",
         "asset": "repo:github/octo/app/deploy-key/ci",
         "severity": "low",
         "title": "deploy key ci (write) not used for 180 days (or never)"
        },
        {
         "check": "identity.fork_pr_approval_weak",
         "asset": "repo:github/octo/app",
         "severity": "low",
         "needs_human": false
        },
        {
         "check": "identity.token_age_over_90d",
         "asset": "credential:gh-keyring/gh:octo",
         "severity": "medium",
         "title": {
          "$regex": "^oauth_token gh:octo is [0-9]+ days old \\(rotate every 90 days\\)$"
         }
        },
        {
         "check": "identity.token_classic_full_repo",
         "asset": "credential:gh-keyring/gh:octo",
         "severity": "medium"
        },
        {
         "check": "identity.credential_expired",
         "asset": "credential:tailscale/device/old-laptop",
         "severity": "low",
         "title": "device_key device/old-laptop expired 2021-01-01 and is still configured"
        },
        {
         "check": "identity.overlay_device_dormant",
         "asset": "credential:tailscale/device/old-laptop",
         "severity": "low"
        },
        {
         "check": "identity.token_expiring_soon",
         "asset": "credential:tailscale/device/phone",
         "severity": "medium"
        },
        {
         "check": "identity.credential_expired",
         "asset": "credential:kubeconfig/kube:config.yaml/admin",
         "severity": "low",
         "title": "kube_client_cert kube:config.yaml/admin expired 2021-01-01 and is still configured"
        },
        {
         "check": "identity.credential_file_readable",
         "asset": "credential:file/file:a.token",
         "severity": "high",
         "title": "file:a.token file is readable by others (0o644)"
        }
       ]
      }
     }
    },
    {
     "json": "run/raw/identity/inventory.json",
     "subset": {
      "accounts": [
       {
        "provider": "github",
        "id": "octo",
        "kind": "human",
        "mfa": null,
        "created_at": "2019-05-01T00:00:00Z"
       }
      ],
      "orgs": [
       {
        "provider": "github",
        "id": "acme",
        "mfa_required": false,
        "members": 2,
        "outside_collaborators": 1
       }
      ],
      "grants": {
       "$len": 8
      },
      "policies": [
       {
        "name": "fork_pr_approval",
        "value": "first_time_contributors",
        "public": true
       }
      ],
      "credentials": [
       {
        "store": "gh-keyring",
        "id": "gh:octo",
        "kind": "oauth_token",
        "scopes": [
         "repo",
         "read:org"
        ],
        "created_at": "2020-01-01T00:00:00Z",
        "updated_at": "2021-01-01T00:00:00Z",
        "location": "keyring"
       },
       {
        "id": "device/old-laptop",
        "kind": "device_key",
        "expires_at": "2021-01-01T00:00:00Z"
       },
       {
        "id": "device/phone"
       },
       {
        "id": "device/server",
        "expires_at": null,
        "notes": "key expiry disabled"
       },
       {
        "id": "kube:config.yaml/admin",
        "kind": "kube_client_cert",
        "expires_at": "2021-01-01T00:00:00Z",
        "scopes": [
         "system:masters",
         "dev-team"
        ],
        "mode": "0o600",
        "notes": "groups = certificate O"
       },
       {
        "id": "kube:config.yaml/ci",
        "kind": "kube_token",
        "notes": "static bearer token"
       },
       {
        "id": "kube:config.yaml/sso",
        "kind": "kube_exec",
        "notes": "exec plugin kubelogin"
       },
       {
        "id": "ssh:id_ed25519",
        "kind": "ssh_key",
        "scopes": [
         "ssh-ed25519"
        ],
        "mode": "0o600"
       },
       {
        "id": "registry:ghcr.example",
        "kind": "registry",
        "notes": "credsStore desktop"
       },
       {
        "id": "registry:registry.example",
        "notes": "inline auth in file"
       },
       {
        "id": "file:a.token",
        "kind": "token_file",
        "mode": "0o644",
        "age_days": {
         "$type": "number"
        }
       },
       {
        "id": "file:b.token",
        "mode": "0o600"
       }
      ]
     }
    },
    {
     "prom": "run/identity.prom",
     "has": [
      {
       "name": "security_identity_credentials",
       "labels": {
        "kind": "device_key"
       },
       "value": 3
      },
      {
       "name": "security_identity_credentials",
       "labels": {
        "kind": "registry"
       },
       "value": 2
      },
      {
       "name": "security_identity_credentials",
       "labels": {
        "kind": "token_file"
       },
       "value": 2
      },
      {
       "name": "security_identity_accounts",
       "value": 1
      },
      {
       "name": "security_identity_mfa_unknown",
       "value": 1
      },
      {
       "name": "security_identity_grants",
       "value": 8
      },
      {
       "name": "security_collector_gaps",
       "labels": {
        "collector": "identity"
       },
       "value": 3
      }
     ]
    },
    {
     "file": ".svc-api.calls",
     "not_regex": [
      "^(?!GET |POST /api/v2/oauth/token |$)"
     ]
    },
    {
     "file": ".svc-api.calls",
     "not_regex": [
      "elsewhere",
      "other/x",
      "octo/old"
     ]
    },
    {
     "file": ".svc-gh.calls",
     "not_regex": [
      "conformanceCanary"
     ]
    }
   ]
  },
  {
   "name": "collect again: conditional requests, same document",
   "remove": [
    "run"
   ],
   "exec": {
    "impl": "collector-identity",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:{path}",
     "FAKE_GH_URL": "{svc_api}",
     "FAKE_GH_LOG": "{sandbox}/.svc-gh.calls"
    },
    "writes_only_under": [
     "run",
     "data/cache"
    ]
   },
   "expect": [
    {
     "json": "run/identity.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "identity"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "no_secret": [
      "conformanceCanary",
      "kube-conformance-token-canary-51aa",
      "docker-conformance-auth-canary-2f0e",
      "{fake_key}",
      "token-file-canary-0b3d",
      "ts-conformance-api-key-canary-4b2e",
      "ts-conformance-oauth-secret-canary-9a3c",
      "ts-conformance-access-canary-1c4f"
     ],
     "in": "run"
    },
    {
     "json": "run/identity.findings.json",
     "subset": {
      "findings": {
       "$unordered": [
        {
         "check": "identity.org_mfa_not_required",
         "asset": "org:github/acme",
         "severity": "medium",
         "needs_human": true,
         "owner": "human",
         "evidence": "raw/identity/inventory.json",
         "title": "organisation acme does not require 2FA of its members"
        },
        {
         "check": "identity.collaborator_unexpected",
         "asset": "repo:github/octo/app/collaborator/mallory",
         "severity": "high",
         "title": "mallory has push access to github/octo/app and is not in the expected list"
        },
        {
         "check": "identity.collaborator_unexpected",
         "asset": "repo:github/octo/notes/collaborator/viewer",
         "severity": "medium"
        },
        {
         "check": "identity.deploy_key_unused",
         "asset": "repo:github/octo/app/deploy-key/ci",
         "severity": "low",
         "title": "deploy key ci (write) not used for 180 days (or never)"
        },
        {
         "check": "identity.fork_pr_approval_weak",
         "asset": "repo:github/octo/app",
         "severity": "low",
         "needs_human": false
        },
        {
         "check": "identity.token_age_over_90d",
         "asset": "credential:gh-keyring/gh:octo",
         "severity": "medium",
         "title": {
          "$regex": "^oauth_token gh:octo is [0-9]+ days old \\(rotate every 90 days\\)$"
         }
        },
        {
         "check": "identity.token_classic_full_repo",
         "asset": "credential:gh-keyring/gh:octo",
         "severity": "medium"
        },
        {
         "check": "identity.credential_expired",
         "asset": "credential:tailscale/device/old-laptop",
         "severity": "low",
         "title": "device_key device/old-laptop expired 2021-01-01 and is still configured"
        },
        {
         "check": "identity.overlay_device_dormant",
         "asset": "credential:tailscale/device/old-laptop",
         "severity": "low"
        },
        {
         "check": "identity.token_expiring_soon",
         "asset": "credential:tailscale/device/phone",
         "severity": "medium"
        },
        {
         "check": "identity.credential_expired",
         "asset": "credential:kubeconfig/kube:config.yaml/admin",
         "severity": "low",
         "title": "kube_client_cert kube:config.yaml/admin expired 2021-01-01 and is still configured"
        },
        {
         "check": "identity.credential_file_readable",
         "asset": "credential:file/file:a.token",
         "severity": "high",
         "title": "file:a.token file is readable by others (0o644)"
        }
       ]
      }
     }
    },
    {
     "file": ".svc-api.calls",
     "regex": [
      "^GET /user auth=yes inm=yes$",
      "^GET /repos/octo/app/keys auth=yes inm=yes$"
     ]
    }
   ]
  }
 ]
}
