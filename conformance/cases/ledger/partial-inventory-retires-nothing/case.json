   "files": {
    "run2/vuln-intel.findings.json": "run2.json"
   },
   "exec": {
    "impl": "ledger",
    "args": [
     "--run",
     "{sandbox}/run2",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "data/ledger.json",
     "subset": {
      "entries": {
       "d610b9b1761d": {
        "status": "open"
       }
      }
     },
     "schema": "ledger"
    }
   ]
  },
  {
   "name": "complete_scope image: with a gap on the old image; repo: is outside the scope",
   "files": {
    "run3/vuln-intel.findings.json": "run3.json"
   },
   "exec": {
    "impl": "ledger",
    "args": [
     "--run",
     "{sandbox}/run3",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "data/ledger.json",
     "subset": {
      "entries": {
       "d610b9b1761d": {
        "status": "open"
       },
       "e68f2007067c": {
        "status": "open"
       }
      }
     },
     "schema": "ledger"
    }
   ]
  }
 ]
