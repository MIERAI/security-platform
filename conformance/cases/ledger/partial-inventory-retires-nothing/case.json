{
 "component": "ledger",
 "title": "Without complete_scope (partial or failed inventory) an unlisted asset is unknown: nothing closes; a gap on the asset also blocks retirement; complete_scope only covers its own prefix",
 "contract": "ledger/1.0",
 "origin": "tests/test_retired.py::test_partial_or_failed_inventory_does_not_close, test_scope_limits_retirement",
