{
 "component": "ledger",
 "title": "An accepted finding that a covering run no longer reports is fixed (the exception no longer matters)",
 "contract": "ledger/1.0",
 "origin": "tests/test_ledger.py::test_accepted_finding_can_be_fixed",
 "files": {
  "data/exceptions.yaml": "valid.yaml"
 },
 "steps": [
  {
   "name": "merge run1",
   "files": {
    "run1/host.findings.json": "run1.json"
   },
   "exec": {
    "impl": "ledger",
    "args": [
     "--run",
     "{sandbox}/run1",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": []
  },
  {
   "name": "merge run2",
   "files": {
    "run2/host.findings.json": "run2.json"
   },
   "exec": {
    "impl": "ledger",
    "args": [
     "--run",
     "{sandbox}/run2",
     "--data",
     "{sandbox}/data"
    ]
   },
   "exit": 0,
   "expect": [
    {
     "json": "data/ledger.json",
     "subset": {
      "entries": {
       "6bad575931fc": {
        "status": "fixed",
        "fixed_reason": "not_observed"
       }
      }
     },
     "schema": "ledger"
    }
   ]
  }
 ]
}
