{
 "component": "collector-k8s",
 "title": "A RoleBinding to a namespaced Role is judged by the Role's rules like one to a ClusterRole: reading Secrets through a Role is reported",
 "contract": "collector-protocol/1.0 / findings/1.2",
 "deviation": "K8S-D4",
 "origin": "only ClusterRole references were looked up",
 "files": {
  "instance.json": "instance.json",
  "data/.keep": {
   "text": ""
  },
  "bin/kubectl": {
   "text": "#!/bin/sh\nexec \"{python}\" \"{case}/fake_kubectl.py\" \"$@\"\n",
   "mode": "0755"
  },
  "bin/sudo": {
   "text": "#!/bin/sh\n[ \"$1\" = \"-n\" ] && shift\nexec \"$@\"\n",
   "mode": "0755"
  },
  "kube/rbac.json": "rbac.json"
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-k8s",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:{path}",
     "FAKE_KUBE_DIR": "{sandbox}/kube",
     "FAKE_KUBE_LOG": "{sandbox}/.svc-kubectl.calls"
    },
    "writes_only_under": [
     "run"
    ]
   },
   "expect": [
    {
     "json": "run/k8s.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "k8s"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/k8s.findings.json",
     "subset": {
      "findings": [
       {
        "check": "k8s.rbac.secrets_read",
        "asset": "k8s-identity:rbac/User:carol",
        "severity": "medium",
        "layer": "identity",
        "title": "User:carol has secrets-read (ns:web, via secret-reader)"
       }
      ]
     }
    },
    {
     "file": ".svc-kubectl.calls",
     "not_regex": [
      "^[a-z-]+: (?!get |auth whoami )"
     ]
    },
    {
     "file": ".svc-kubectl.calls",
     "regex": [
      "^rbac: get roles -A -o json$"
     ]
    }
   ]
  }
 ]
}
