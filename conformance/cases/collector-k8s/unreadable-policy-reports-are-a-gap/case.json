{
 "component": "collector-k8s",
 "title": "PolicyReports that exist but cannot be listed (forbidden) are a narrow gap of the policy checks, never the finding that no policy engine is installed; only a missing resource type means no engine",
 "contract": "collector-protocol/1.0 / findings/1.2",
 "deviation": "K8S-D2",
 "origin": "any kubectl error was read as `no admission policy engine`",
 "files": {
  "instance.json": "instance.json",
  "data/.keep": {
   "text": ""
  },
  "bin/kubectl": {
   "text": "#!/bin/sh\nexec \"{python}\" \"{case}/fake_kubectl.py\" \"$@\"\n",
   "mode": "0755"
  },
  "bin/sudo": {
   "text": "#!/bin/sh\n[ \"$1\" = \"-n\" ] && shift\nexec \"$@\"\n",
   "mode": "0755"
  },
  "kube/lab.json": "lab.json"
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-k8s",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:{path}",
     "FAKE_KUBE_DIR": "{sandbox}/kube",
     "FAKE_KUBE_LOG": "{sandbox}/.svc-kubectl.calls"
    },
    "writes_only_under": [
     "run"
    ]
   },
   "expect": [
    {
     "json": "run/k8s.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "k8s"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/k8s.findings.json",
     "subset": {
      "coverage": {
       "$contains": [
        {
         "asset": "k8s-cluster:lab",
         "status": "ok"
        },
        {
         "asset": "k8s-cluster:lab/policy",
         "status": "gap",
         "checks": [
          "k8s.policy.*"
         ],
         "reason": {
          "$regex": "[Ff]orbidden"
         }
        }
       ]
      },
      "findings": {
       "$not_contains": [
        {
         "check": "k8s.policy.engine_missing"
        }
       ]
      }
     }
    },
    {
     "file": ".svc-kubectl.calls",
     "not_regex": [
      "^[a-z-]+: (?!get |auth whoami )"
     ]
    }
   ]
  }
 ]
}
