{
 "component": "collector-host",
 "title": "Probe output of linux, macOS, busybox and Termux hosts over ssh becomes the documented findings, one coverage entry per configured host (a host without exec adapter is a gap with its configured reason, a host scoped to another collector is skipped), ids from (layer, asset, check), the wildcard-listener metric; ssh runs non-interactively with host-key checking that instance options cannot weaken (first value wins) and the probe limits from the instance in the script",
 "contract": "collector-protocol/1.0 / findings/1.2",
 "origin": "collectors/host/collector.py; adapters/exec.py SSH.BASE; tests/test_host_probes.py",
 "files": {
  "bin/ssh": {
   "raw": "fake_exec.sh",
   "mode": "0755"
  },
  "instance.json": {
   "json": {
    "name": "conformance",
    "scope": [
     {
      "names": [
       "elsewhere"
      ],
      "scope": [
       "k8s"
      ]
     }
    ],
    "hosts": [
     {
      "name": "lin",
      "profile": "linux",
      "probe_timeout": 7,
      "slow_probe_timeout": 30,
      "exec": {
       "type": "ssh",
       "host": "lin.test",
       "options": [
        "-o",
        "StrictHostKeyChecking=no",
        "-F",
        "/dev/null"
       ]
      }
     },
     {
      "name": "mac",
      "profile": "macos",
      "exec": {
       "type": "ssh",
       "host": "mac.test"
      }
     },
     {
      "name": "router",
      "profile": "busybox",
      "exec": {
       "type": "ssh",
       "host": "router.test"
      }
     },
     {
      "name": "phone",
      "profile": "termux",
      "exec": {
       "type": "ssh",
       "host": "phone.test"
      }
     },
     {
      "name": "dormant",
      "profile": "linux",
      "exec": null,
      "gap": "powered off by design"
     },
     {
      "name": "elsewhere",
      "profile": "linux",
      "exec": {
       "type": "ssh",
       "host": "elsewhere.test"
      }
     }
    ]
   }
  },
  "data/.keep": {
   "text": ""
  },
  "replay/lin.test.out": {
   "text": "sshd.passwordauthentication=yes\nsshd.permitrootlogin=yes\nsshd.x11forwarding=yes\nsshd.pubkeyauthentication=yes\nos.name=Debian GNU/Linux 13 (trixie)\nos.kernel=6.12.0\nreboot_required=yes\nuptime_days=40\nfw.ufw=inactive\nfw.nft_input_policy=\nfw.iptables_input_policy=ACCEPT\ndisk.crypt_devices=0\naudit.auditd=inactive\nlisten=0.0.0.0:5432 postgres\nlisten=127.0.0.1:6379 redis-server\nlisten=[::]:22 sshd\nlisten=*:9200 java\npkg.auto_updates=no\npkg.cache_mtime={epoch:-864000}\npkg.count=512\npkg.upgradable=12\npkg.security_upgradable=3\nprobe.end=1\n"
  },
  "replay/mac.test.out": {
   "text": "os.name=macOS 26.1 (25B78)\ndisk.filevault=off\nfw.app_firewall=off\nfw.stealth=off\nsip=on\ngatekeeper=off\nssh.remote_login=off\npkg.auto_install_os=unset\npkg.auto_security=1\nuptime_days=3\nlisten=127.0.0.1:5432 postgres\npkg.brew_outdated=25\npkg.os_updates_pending=2\nprobe.end=1\n"
  },
  "replay/router.test.out": {
   "text": "sshd.passwordauthentication=yes\nsshd.permitrootlogin=yes\nos.name=OpenWrt 24.10\nos.kernel=6.6.0\ntelnetd=1\nuptime_days=120\nfw.iptables_input_policy=ACCEPT\nlisten=0.0.0.0:53\nlisten=0.0.0.0:6379\nprobe.end=1\n"
  },
  "replay/phone.test.out": {
   "text": "sshd.passwordauthentication=no\nos.name=Android 14 (patch 2020-01-05)\nos.security_patch=2020-01-05\nuptime_days=9\nlisten=00000000:8022\nlisten=00000000:27017\nproc.secret_in_argv_suspects=1\npkg.cache_mtime=\npkg.upgradable=4\nprobe.end=1\n"
  }
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-host",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:/usr/bin:/bin",
     "FAKE_EXEC": "{sandbox}"
    },
    "writes_only_under": [
     "run",
     "trace"
    ]
   },
   "expect": [
    {
     "json": "run/host.findings.json",
     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "host"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/host.findings.json",
     "subset": {
      "coverage": [
       {
        "asset": "host:lin",
        "status": "ok"
       },
       {
        "asset": "host:mac",
        "status": "ok"
       },
       {
        "asset": "host:router",
        "status": "ok"
       },
       {
        "asset": "host:phone",
        "status": "ok"
       },
       {
        "asset": "host:dormant",
        "status": "gap",
        "reason": "powered off by design"
       }
      ],
      "findings": {
       "$unordered": [
        {
         "asset": "host:lin",
         "check": "ssh.password_auth_enabled",
         "severity": "high",
         "layer": "identity",
         "remediation": "PasswordAuthentication no (keys only)"
        },
        {
         "asset": "host:lin",
         "check": "ssh.root_login_password",
         "severity": "high",
         "layer": "identity"
        },
        {
         "asset": "host:lin",
         "check": "ssh.x11_forwarding",
         "severity": "low",
         "layer": "host"
        },
        {
         "asset": "host:lin",
         "check": "patch.security_pending",
         "severity": "medium",
         "title": "3 security updates pending"
        },
        {
         "asset": "host:lin",
         "check": "patch.metadata_stale",
         "severity": "low",
         "title": {
          "$regex": "^package metadata 10 days old"
         }
        },
        {
         "asset": "host:lin",
         "check": "patch.reboot_required",
         "severity": "medium",
         "title": {
          "$regex": "\\(uptime 40d\\)$"
         }
        },
        {
         "asset": "host:lin",
         "check": "patch.auto_updates_off",
         "severity": "low"
        },
        {
         "asset": "host:lin",
         "check": "fw.host_firewall_off",
         "severity": "medium",
         "layer": "network"
        },
        {
         "asset": "host:lin",
         "check": "listen.db_wildcard.5432",
         "severity": "medium",
         "layer": "network",
         "evidence": "raw/host/lin.json"
        },
        {
         "asset": "host:lin",
         "check": "listen.db_wildcard.9200",
         "severity": "medium",
         "title": {
          "$regex": "\\(\\*:9200 java\\)$"
         }
        },
        {
         "asset": "host:mac",
         "check": "macos.disk_filevault_off",
         "severity": "high",
         "needs_human": true,
         "owner": "human"
        },
        {
         "asset": "host:mac",
         "check": "macos.fw_app_firewall_off",
         "severity": "medium",
         "needs_human": false,
         "owner": "platform"
        },
        {
         "asset": "host:mac",
         "check": "macos.gatekeeper_off",
         "severity": "high",
         "needs_human": true
        },
        {
         "asset": "host:mac",
         "check": "macos.fw_stealth_off",
         "severity": "low"
        },
        {
         "asset": "host:mac",
         "check": "patch.os_updates_pending",
         "severity": "medium",
         "title": "2 OS updates pending",
         "needs_human": true
        },
        {
         "asset": "host:mac",
         "check": "patch.brew_outdated",
         "severity": "low",
         "title": "25 Homebrew packages outdated"
        },
        {
         "asset": "host:router",
         "check": "ssh.password_auth_enabled",
         "severity": "high"
        },
        {
         "asset": "host:router",
         "check": "ssh.root_login_password",
         "severity": "high"
        },
        {
         "asset": "host:router",
         "check": "telnet.daemon_running",
         "severity": "high",
         "layer": "network"
        },
        {
         "asset": "host:router",
         "check": "listen.db_wildcard.6379",
         "severity": "medium"
        },
        {
         "asset": "host:phone",
         "check": "patch.pending",
         "severity": "low",
         "title": "4 package updates pending"
        },
        {
         "asset": "host:phone",
         "check": "patch.android_security_patch_old",
         "severity": "medium",
         "needs_human": true
        },
        {
         "asset": "host:phone",
         "check": "secret.in_process_argv",
         "severity": "medium",
         "layer": "data-secrets"
        },
        {
         "asset": "host:phone",
         "check": "listen.db_wildcard.27017",
         "severity": "medium"
        }
       ]
      }
     }
    },
    {
     "prom": "run/host.prom",
     "has": [
      {
       "name": "security_host_wildcard_listeners",
       "labels": {
        "host": "lin"
       },
       "value": 3
      },
      {
       "name": "security_host_wildcard_listeners",
       "labels": {
        "host": "mac"
       },
       "value": 0
      },
      {
       "name": "security_host_wildcard_listeners",
       "labels": {
        "host": "phone"
       },
       "value": 2
      },
      {
       "name": "security_collector_findings",
       "labels": {
        "collector": "host",
        "layer": "network",
        "severity": "medium"
       },
       "value": 5
      },
      {
       "name": "security_collector_gaps",
       "labels": {
        "collector": "host"
       },
       "value": 1
      }
     ]
    },
    {
     "json": "run/raw/host/lin.json",
     "subset": {
      "profile": "linux",
      "rc": 0,
      "unread": {},
      "listen": {
       "$len": 4
      },
      "kv": {
       "pkg.count": "512"
      }
     }
    },
    {
     "file": "trace/lin.test.argv",
     "regex": [
      "\\A\\-o\\nBatchMode=yes\\n\\-o\\nConnectTimeout=10\\n\\-o\\nPasswordAuthentication=no\\n\\-o\\nKbdInteractiveAuthentication=no\\n\\-o\\nStrictHostKeyChecking=yes\\n\\-o\\nStrictHostKeyChecking=no\\n\\-F\\n/dev/null\\nlin\\.test\\nsh\\ \\-s\\n\\Z"
     ]
    },
    {
     "file": "trace/lin.test.stdin",
     "regex": [
      "\\ASP_PROBE_TIMEOUT=7\\nSP_PROBE_SLOW_TIMEOUT=30\\n",
      "^sp_probe\\(\\) \\{$",
      "\\necho probe\\.end=1\\n\\Z"
     ]
    },
    {
     "file": "trace/mac.test.stdin",
     "regex": [
      "\\ASP_PROBE_TIMEOUT=20\\nSP_PROBE_SLOW_TIMEOUT=90\\n",
      "^# host profile: macOS"
     ]
    },
    {
     "absent": "trace/elsewhere.test.argv"
    }
   ]
  },
  {
   "name": "collect as another name (SP_COLLECTOR_NAME): document, evidence and pointers follow it",
   "remove": [
    "run",
    "trace"
   ],
   "exec": {
    "impl": "collector-host",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:/usr/bin:/bin",
     "FAKE_EXEC": "{sandbox}",
     "SP_COLLECTOR_NAME": "host-b"
    }
   },
   "expect": [
    {
     "json": "run/host-b.findings.json",
     "schema": "findings",
     "subset": {
      "collector": {
       "name": "host-b"
      },
      "findings": {
       "$contains": [
        {
         "asset": "host:lin",
         "check": "listen.db_wildcard.5432",
         "evidence": "raw/host-b/lin.json"
        }
       ]
      }
     }
    },
    {
     "exists": "run/raw/host-b/lin.json"
    },
    {
     "absent": "run/host.findings.json"
    }
   ]
  }
 ]
}
