         "check": "telnet.daemon_running",
         "severity": "high"
        }
       ]
      }
     }
    },
    {
     "json": "run/host.findings.json",
     "subset": {
      "findings": {
       "$not_contains": [
        {
         "check": "patch.windows_stale"
        },
        {
         "check": "patch.android_security_patch_old"
        }
       ]
      }
     }
    }
   ]
  }
 ]
