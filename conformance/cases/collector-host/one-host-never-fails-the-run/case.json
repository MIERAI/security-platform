     "schema": "findings",
     "findings_ids": true,
     "subset": {
      "collector": {
       "name": "host"
      }
     }
    },
    {
     "writes_only_under": true
    },
    {
     "json": "run/host.findings.json",
     "subset": {
      "coverage": [
       {
        "asset": "host:win",
        "status": "ok"
       },
       {
        "asset": "host:win/windows-updates",
        "status": "gap",
        "checks": [
         "patch.windows_stale"
        ],
        "reason": {
         "$regex": "could not check.*pkg.last_hotfix"
        }
       },
       {
        "asset": "host:tab",
        "status": "ok"
       },
       {
        "asset": "host:tab/android-patch",
        "status": "gap",
        "checks": [
         "patch.android_security_patch_old"
        ]
       },
       {
        "asset": "host:nops",
        "status": "gap",
        "reason": {
