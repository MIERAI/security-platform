       "shell": "windows"
      }
     },
     {
      "name": "tab",
      "profile": "termux",
      "exec": {
       "type": "ssh",
       "host": "tab.test"
      }
     },
     {
      "name": "nops",
      "profile": "windows",
      "exec": {
       "type": "local"
      }
     },
     {
      "name": "fine",
      "profile": "busybox",
      "exec": {
       "type": "ssh",
       "host": "fine.test"
      }
     }
    ]
   }
  },
  "replay/win.test.out": {
   "raw": "win.out"
  },
  "replay/tab.test.out": {
   "text": "os.security_patch=2026-13-45\nproc.secret_in_argv_suspects=1\nprobe.end=1\n"
  },
  "replay/fine.test.out": {
   "text": "sshd.passwordauthentication=yes\nsshd.permitrootlogin=yes\nos.name=OpenWrt 24.10\nos.kernel=6.6.0\ntelnetd=1\nuptime_days=120\nfw.iptables_input_policy=ACCEPT\nlisten=0.0.0.0:53\nlisten=0.0.0.0:6379\nprobe.end=1\n"
  }
 },
 "steps": [
  {
   "name": "collect",
   "exec": {
    "impl": "collector-host",
    "env": {
     "SP_RUN_DIR": "{sandbox}/run",
     "SP_INSTANCE": "{sandbox}/instance.json",
     "SP_DATA": "{sandbox}/data",
     "SP_INPUT_DIR": "{sandbox}/data/latest",
     "SP_INSTANCE_NAME": "conformance",
     "PATH": "{sandbox}/bin:/usr/bin:/bin",
     "FAKE_EXEC": "{sandbox}"
