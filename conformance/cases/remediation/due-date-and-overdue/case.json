       "value": 1
      },
      {
       "name": "security_remediation_open",
       "labels": {
        "severity": "high"
       },
       "value": 1
      },
      {
       "name": "security_remediation_slo_seconds",
       "labels": {
        "severity": "critical"
       },
       "value": 604800
      },
      {
       "name": "security_remediation_unassigned",
       "value": 0
      }
     ],
     "families": [
      "security_remediation_last_update_timestamp_seconds"
     ]
    }
   ]
  }
 ]
}
