#!/bin/sh
# Go implementation of the `cli` component for the conformance suite: `sp`, the binary of this checkout.
# $SP_GO_SP names a built binary; without it the binary is built (go build, cached by Go) into $SP_GO_BUILD_DIR
# (default: a directory under $TMPDIR). The product tree (collectors, runner) is this checkout. No external command
# runs when $SP_GO_SP is set (a case may run with an empty PATH): the tree is found by parameter expansion.
set -eu
case $0 in */*) here=${0%/*} ;; *) here=. ;; esac
SP_PY_HOME=${SP_PY_HOME:-$here/../../..}
export SP_PY_HOME
if [ -z "${SP_GO_SP:-}" ]; then
  dir=${SP_GO_BUILD_DIR:-${TMPDIR:-/tmp}/sp-conformance-go}
  mkdir -p "$dir"
  (cd "$SP_PY_HOME" && go build -trimpath -o "$dir/sp" ./cmd/sp)
  SP_GO_SP=$dir/sp
fi
exec "$SP_GO_SP" "$@"
