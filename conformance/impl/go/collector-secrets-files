#!/bin/sh
# Go implementation of the `collector-secrets-files` component for the conformance suite: `sp secrets-files collect`. The collector cases
# run with a fixed PATH (fake ssh/sh/sudo targets), so the binary is not built here: $SP_GO_SP names it
# (conformance/impl/go/run.sh builds it and sets it).
set -eu
exec "${SP_GO_SP:?set SP_GO_SP to a built sp binary: conformance/impl/go/run.sh does}" secrets-files collect "$@"
